=== example 9: $area: f64 = match ($shape) {
mode: statements
(file
  (namespace Spec)
  (function example
    (params)
    (returns void)
    (block
      (local $area f64
        (match
          (subject $shape)
          (arm (path Shape ::CIRCLE (payload (bind $r))) (=> (* (* \Math\PI $r) $r)))
          (arm
            (path Shape ::RECT (payload (bind $w) (bind $h)))
            (if (== $w $h))
            (=> (* $w $w)))
          (arm (path Shape ::RECT (payload (bind $w) (bind $h))) (=> (* $w $h))))))))

