mode: statements
(file
  (namespace Spec)
  (function example
    (params)
    (returns void)
    (block
      (local $label string
        (match
          (subject $opt)
          (arm (lit null) (=> "none"))
          (arm (typed $v int) (=> (interp "value " $v)))))
      (local $size int
        (match
          (subject $x)
          (arm (typed $n int) (=> $n))
          (arm (typed $s string) (=> (call (-> $s byteLength)))))))))

=== example 11: match ($x) {
mode: statements
(file
  (namespace Spec)
  (function example
    (params)
    (returns void)
    (block
      (match-stmt
        (subject $x)
        (arm (lit 0) (=> "zero"))
        (arm (== $limit) (=> "at limit"))
        (arm (== (call maxFor $u)) (=> "at max"))
        (arm (bind $n) (if (> $n 100)) (=> "big"))
        (arm default (=> "other"))))))

