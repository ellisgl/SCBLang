=== example 16: $users: list<User> = \Task\scope(fn($s: \Task\Scope): list<User> {
mode: statements
(file
  (namespace Spec)
  (function example
    (params)
    (returns void)
    (block
      (local $users
        (generic list User)
        (call \Task\scope
          (fn
            (params (param $s \Task\Scope))
            (returns (generic list User))
            (block
              (local $a
                (generic \Task\Handle User)
                (call
                  (-> $s spawn)
                  (fn (params) (returns User) (=> (call (-> $repo find) 1)))))
              (local $b
                (generic \Task\Handle User)
                (call
                  (-> $s spawn)
                  (fn (params) (returns User) (=> (call (-> $repo find) 2)))))
              (return (list (call (-> $a await)) (call (-> $b await)))))))))))

=== example 17: $action: Action = \Task\select(
mode: statements
(file
  (namespace Spec)
  (function example
    (params)
    (returns void)
    (block
      (local $action Action
        (call \Task\select
          (call
            (-> $jobs onReceive)
            (fn (params (param $job (? Job))) (returns Action) (=> (call handle $job))))
          (call
            (-> $quit onReceive)
            (fn (params (param $_ (? bool))) (returns Action) (=> (:: Action STOP))))
          (call
            (-> $out onSend)
            $r
            (fn (params) (returns Action) (=> (:: Action SENT))))
          (call \Task\onTimeout
            (call (:: \Time\Duration seconds) 1)
            (fn (params) (returns Action) (=> (:: Action TIMEOUT)))))))))

