// EXPECT-STDOUT:
// | drop a
// | drop b
// | ~x
// | done
namespace Conformance;

class X
{
    public function __destruct() { echo "~x\n"; }
}

function main(): void
{
    $a: ?X = new X();
    $b: ?X = $a;
    $list: list<?X> = [$a];
    echo "drop a\n";
    $a = null;
    echo "drop b\n";
    $b = null;
    $list->clear();
    echo "done\n";
}
