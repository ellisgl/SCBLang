// EXPECT-STDOUT:
// | base id, child name

namespace Conformance;

extendable class Base
{
    final public function id(): string
    {
        return 'base id';
    }

    public function name(): string
    {
        return 'base name';
    }
}

class Child extends Base
{
    public function name(): string
    {
        return 'child name';
    }
}

function main(): void
{
    $c: Child = new Child();
    echo $c->id(), ", ", $c->name(), "\n";
}
