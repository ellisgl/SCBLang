// EXPECT-STDOUT:
// | 3 false
// | 104 105
// | 3
// | hi!
// | 104,105,33
// | hi!?
// | null
// | true 5 1,2,3,4,5
// | 5,4,3,2,1
// | 1,3,5 5,3,1
// | 0 false
namespace Conformance;

function b($v: bool): string
{
    return $v ? 'true' : 'false';
}

function main(): void
{
    $data: bytes = "hi!"->bytes();
    echo $data->count(), ' ', b($data->isEmpty()), "\n";
    echo $data[0], ' ', $data[1], "\n";
    echo $data->slice(0..<3)->count(), "\n";
    echo $data->decodeUtf8(), "\n";
    $codes: list<string> = [];
    foreach ($data as $byte) {
        $codes->push((string) $byte);
    }
    echo $codes->join(','), "\n";
    $more: bytes = $data->concat("?"->bytes());
    echo $more->decodeUtf8(), "\n";
    $bad: bytes = "é"->bytes()->slice(0..<1);
    echo $bad->tryDecodeUtf8() ?? 'null', "\n";

    $r: Range<int> = 1..=5;
    echo b($r->contains(3)), ' ', $r->count(), ' ', $r->toList()->join(','), "\n";
    echo $r->reversed()->toList()->join(','), "\n";
    echo $r->step(2)->toList()->join(','), ' ', $r->reversed()->step(2)->toList()->join(','), "\n";
    $e: Range<int> = 5..<5;
    echo $e->count(), ' ', b($e->contains(5)), "\n";
}
