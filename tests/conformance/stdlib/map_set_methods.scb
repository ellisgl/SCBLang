// EXPECT-STDOUT:
// | 3 false true false
// | 1 null
// | b,a,c 2,1,3
// | b=2 a=1 c=3
// | 1 null b,c
// | b=20 c=3 d=4
// | b=2
// | b=4 c=6
// |  b:2 c:3
// | true false
// | 0 true
// | 3 true false
// | 1,2,3,4 2,3 1
// | 1,3
namespace Conformance;

function o($v: ?int): string
{
    return $v == null ? 'null' : (string) $v;
}

function b($v: bool): string
{
    return $v ? 'true' : 'false';
}

function pairs($m: map<string, int>): string
{
    return $m->entries()->map(fn($e: tuple<string, int>): string => "{$e[0]}={$e[1]}")->join(' ');
}

function main(): void
{
    $m: map<string, int> = ['b' => 2, 'a' => 1, 'c' => 3];
    echo $m->count(), ' ', b($m->isEmpty()), ' ', b($m->has('a')), ' ', b($m->has('z')), "\n";
    echo o($m->get('a')), ' ', o($m->get('z')), "\n";
    echo $m->keys()->join(','), ' ', $m->values()->join(','), "\n";
    echo pairs($m), "\n";
    echo o($m->remove('a')), ' ', o($m->remove('a')), ' ', $m->keys()->join(','), "\n";
    echo pairs($m->merge(['b' => 20, 'd' => 4])), "\n";
    echo pairs($m->filter(fn($v: int, $k: string): bool => $k == 'b')), "\n";
    echo pairs($m->mapValues(fn($v: int, $k: string): int => $v * 2)), "\n";
    $m->each(fn($v: int, $k: string): void => \Io\print(" {$k}:{$v}"));
    echo "\n";
    echo b($m->any(fn($v: int, $k: string): bool => $v > 2)), ' ', b($m->all(fn($v: int, $k: string): bool => $v > 2)), "\n";
    $m->clear();
    echo $m->count(), ' ', b($m->isEmpty()), "\n";

    $s: set<int> = [1, 2, 3];
    $s->add(2);
    echo $s->count(), ' ', b($s->has(2)), ' ', b($s->has(9)), "\n";
    $t: set<int> = [2, 3, 4];
    echo $s->union($t)->values()->join(','), ' ', $s->intersect($t)->values()->join(','), ' ', $s->diff($t)->values()->join(','), "\n";
    $s->remove(2);
    echo $s->values()->join(','), "\n";
}
