// EXPECT-COMPILE-ERROR: type-mismatch

namespace Conformance;

// The right operand of `&&` may have run (and assigned) when the condition is false.

function main(): void
{
    $z: ?int = 1;
    if ($z == null) {
        return;
    }
    $c: bool = true;
    $w: int = $c && ($z = null) != null ? 0 : $z;
    echo $w, "\n";
}
