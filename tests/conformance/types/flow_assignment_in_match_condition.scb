// EXPECT-COMPILE-ERROR: type-mismatch

namespace Conformance;

// A subjectless `match` tries its conditions in order: a later arm runs after an earlier condition assigned.

function main(): void
{
    $z: ?int = 1;
    if ($z == null) {
        return;
    }
    $w: int = match {
        ($z = null) != null => 0,
        default => $z,
    };
    echo $w, "\n";
}
