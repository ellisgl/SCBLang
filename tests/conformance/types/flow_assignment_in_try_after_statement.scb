// EXPECT-COMPILE-ERROR: type-mismatch

namespace Conformance;

// After a `try` statement, an assignment in its body still counts.

function main(): void
{
    $z: ?int = 1;
    if ($z != null) {
        try {
            $z = null;
        } catch (\Exception) {
        }
        echo $z + 1, "\n";
    }
}
