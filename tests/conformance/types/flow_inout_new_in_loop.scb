// EXPECT-COMPILE-ERROR: type-mismatch

namespace Conformance;

// An `inout` constructor argument assigns: facts about it do not hold inside the loop.

class Clearer
{
    public function __construct(inout $x: ?int)
    {
        $x = null;
    }
}

function main(): void
{
    $z: ?int = 1;
    if ($z == null) {
        return;
    }
    for ($i: int = 0; $i < 2; $i++) {
        echo $z + 1, "\n";
        $c: Clearer = new Clearer(inout $z);
    }
}
