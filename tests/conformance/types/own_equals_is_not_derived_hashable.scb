// EXPECT-COMPILE-ERROR: unsatisfied-bound

namespace Conformance;

// A struct with its own `equals()` does not derive `Hashable` (SPEC "Auto-derivation"): a derived hash
// would disagree with it (here 'A' and 'a' are equal but hash differently).

struct Name implements \Equatable
{
    public function __construct(public $s: string) {}

    public function equals($other: self): bool
    {
        return $this->s->toLower() == $other->s->toLower();
    }
}

function main(): void
{
    $m: map<Name, int> = [];
}
