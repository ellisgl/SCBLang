namespace Conformance;

// Range equality is not specified yet (Q46): comparing ranges is a compile error
// rather than a guess (as values, `(1..<1)` and `(5..<5)` differ; as sequences,
// both are empty).

function main(): void
{
    echo (1..<1) == (5..<5) ? "equal\n" : "different\n";
}
