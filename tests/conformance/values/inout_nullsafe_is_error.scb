// EXPECT-COMPILE-ERROR: write-through-nullsafe

namespace Conformance;

class Box
{
    public function __construct(public $v: int) {}
}

function maybeBox(): ?Box
{
    return new Box(1);
}

function bump(inout $n: int): void
{
    $n += 1;
}

function main(): void
{
    $b: ?Box = maybeBox();
    bump(inout $b?->v);
}
