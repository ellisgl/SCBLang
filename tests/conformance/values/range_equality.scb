// EXPECT-STDOUT:
// | true true true false false true
// | true
namespace Conformance;

// SPEC "Ranges" (Q46): ranges are equal when they produce the same values. All
// empty ranges are equal; the step matters only with two or more values.

struct Window
{
    public function __construct(public $span: Range<int>) {}
}

function b($x: bool): string
{
    return $x ? 'true' : 'false';
}

function main(): void
{
    echo b((1..<1) == (5..<5)), ' ',
        b((0..<10)->step(20) == (0..=0)), ' ',
        b((1..=3)->reversed()->reversed() == (1..=3)), ' ',
        b((1..=3) == (1..=4)), ' ',
        b((1..=3) == (1..=3)->reversed()), ' ',
        b((0..<10)->step(2) == (0..=8)->step(2)), "\n";
    echo b(new Window(1..<3) == new Window(1..=2)), "\n";
}
