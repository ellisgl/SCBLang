// EXPECT-STDOUT:
// | 0 none 6 1 3

namespace Conformance;

function main(): void
{
    $empty: list<int> = [];
    $nums: list<int> = [3, 1, 2];
    echo $empty->sum(), " ", $empty->max() == null ? 'none' : 'some', " ";
    echo $nums->sum(), " ", $nums->min() ?? 0, " ", $nums->max() ?? 0, "\n";
}
